{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "text"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "text": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "attachmentIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^att_[a-f0-9]{32}$"
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "required": [
        "attachmentIds"
      ]
    }
  ]
}
